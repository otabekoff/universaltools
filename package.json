{
    "name": "universaltools",
    "displayName": "UniversalTools",
    "description": "A curated pack of modern web-development extensions (Vue, React, Svelte, Astro, Tailwind, Vite/Vitest, Node.js and more) installed in one click.",
    "version": "4.0.0",
    "publisher": "universaltools",
    "author": {
        "name": "Otabek Sadiridinov",
        "url": "https://github.com/otabekoff"
    },
    "license": "MIT",
    "icon": "icon.png",
    "galleryBanner": {
        "color": "#3F51D8",
        "theme": "dark"
    },
    "homepage": "https://github.com/otabekoff/universaltools#readme",
    "bugs": {
        "url": "https://github.com/otabekoff/universaltools/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/otabekoff/universaltools"
    },
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Extension Packs"
    ],
    "keywords": [
        "extension pack",
        "web development",
        "vue",
        "react",
        "svelte",
        "astro",
        "tailwind",
        "vite",
        "vitest",
        "prettier",
        "eslint",
        "biome",
        "node"
    ],
    "scripts": {
        "verify": "node scripts/verify-pack.mjs",
        "verify:all": "node scripts/verify-pack.mjs --all",
        "package": "vsce package",
        "test:install": "node scripts/install-test.mjs",
        "test:install:local": "node scripts/install-test.mjs --use-installed",
        "test": "npm run verify && npm run package && npm run test:install",
        "icon": "python scripts/make-icon.py icon.png"
    },
    "devDependencies": {
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^4.1.1",
        "ovsx": "^1.4.0"
    },
