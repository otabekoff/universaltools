{
    "name": "universaltools",
    "displayName": "UniversalTools",
    "description": "A curated pack of modern web-development extensions (Vue, React, Svelte, Astro, Tailwind, Vite/Vitest, Node.js and more) installed in one click.",
    "version": "4.0.0",
    "publisher": "universaltools",
    "author": {
        "name": "Otabek Sadiridinov",
        "url": "https://github.com/otabekoff"
    },
    "license": "MIT",
    "icon": "icon.png",
    "galleryBanner": {
        "color": "#3F51D8",
        "theme": "dark"
    },
    "homepage": "https://github.com/otabekoff/universaltools#readme",
    "bugs": {
        "url": "https://github.com/otabekoff/universaltools/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/otabekoff/universaltools"
    },
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Extension Packs",
        "Other"
    ],
    "keywords": [
        "extension pack",
        "web development",
        "vue",
        "react",
        "svelte",
        "astro",
        "tailwind",
        "vite",
        "vitest",
        "prettier",
        "eslint",
        "biome",
        "node"
    ],
    "main": "./extension.js",
    "activationEvents": [],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": true
        },
        "virtualWorkspaces": true
    },
    "contributes": {
        "commands": [
            {
                "command": "universaltools.checkHealth",
                "title": "Check Pack Health",
                "category": "UniversalTools"
            },
            {
                "command": "universaltools.removeDroppedExtensions",
                "title": "Remove Extensions Dropped in 4.0",
                "category": "UniversalTools"
            },
            {
                "command": "universaltools.openWalkthrough",
                "title": "Get Started",
                "category": "UniversalTools"
            }
        ],
        "configurationDefaults": {
            "editor.linkedEditing": true,
            "editor.guides.bracketPairs": "active",
            "[css]": {
                "editor.defaultFormatter": "esbenp.prettier-vscode"
            },
            "[scss]": {
                "editor.defaultFormatter": "esbenp.prettier-vscode"
            },
            "[less]": {
                "editor.defaultFormatter": "esbenp.prettier-vscode"
            },
            "[xml]": {
                "editor.defaultFormatter": "redhat.vscode-xml"
            }
        },
        "walkthroughs": [
            {
                "id": "universaltools.welcome",
                "title": "Get started with UniversalTools",
                "description": "What the pack installs, the settings it turns on, and how to clean up after upgrading.",
                "steps": [
                    {
                        "id": "welcome",
                        "title": "What's in the pack",
                        "description": "A curated set of web-development extensions, installed together.\n[Open the README](https://github.com/otabekoff/universaltools#readme)",
                        "media": {
                            "markdown": "walkthrough/welcome.md"
                        },
                        "completionEvents": [
                            "onStepSelected"
                        ]
                    },
                    {
                        "id": "settings",
                        "title": "Recommended settings are on",
                        "description": "Auto rename tag, bracket guides and stylesheet/XML formatters are set as defaults. Your own settings still win.\n[Open Settings (JSON)](command:workbench.action.openSettingsJson)",
                        "media": {
                            "markdown": "walkthrough/settings.md"
                        },
                        "completionEvents": [
                            "onStepSelected"
                        ]
                    },
                    {
                        "id": "cleanup",
                        "title": "Remove extensions dropped in 4.0",
                        "description": "Upgrading from 3.x? Uninstall the deprecated and duplicate extensions the old pack installed.\n[Remove Dropped Extensions](command:universaltools.removeDroppedExtensions)",
                        "media": {
                            "markdown": "walkthrough/cleanup.md"
                        },
                        "completionEvents": [
                            "onCommand:universaltools.removeDroppedExtensions"
                        ]
                    },
                    {
                        "id": "health",
                        "title": "Check pack health",
                        "description": "See which pack extensions are missing or disabled, and install them.\n[Check Pack Health](command:universaltools.checkHealth)",
                        "media": {
                            "markdown": "walkthrough/health.md"
                        },
                        "completionEvents": [
                            "onCommand:universaltools.checkHealth"
                        ]
                    }
                ]
            }
        ]
    },
    "scripts": {
        "verify": "node scripts/verify-pack.mjs",
        "verify:all": "node scripts/verify-pack.mjs --all",
        "package": "vsce package",
        "test:install": "node scripts/install-test.mjs",
        "test:install:local": "node scripts/install-test.mjs --use-installed",
        "test": "npm run verify && npm run package && npm run test:install && npm run test:integration",
        "icon": "python scripts/make-icon.py icon.png",
        "test:integration": "node test/run-integration.mjs"
    },
    "devDependencies": {
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^4.1.1",
        "ovsx": "^1.4.0"
    },
    "extensionPack": [
        "adpyke.codesnap",
        "ahmadawais.shades-of-purple",
        "antfu.iconify",
        "antfu.unocss",
        "astro-build.astro-vscode",
        "biomejs.biome",
        "bradlc.vscode-tailwindcss",
        "burkeholland.simple-react-snippets",
        "christian-kohler.npm-intellisense",
        "christian-kohler.path-intellisense",
        "csstools.postcss",
        "dannyconnell.split-html-attributes",
        "DavidAnson.vscode-markdownlint",
        "dbaeumer.vscode-eslint",
        "dennisvhest.npm-browser",
        "dotenv.dotenv-vscode",
        "eamodio.gitlens",
        "ecmel.vscode-html-css",
        "EditorConfig.EditorConfig",
        "esbenp.prettier-vscode",
        "FanaticPythoner.better-todo-tree",
        "firefox-devtools.vscode-firefox-debug",
        "formulahendry.auto-close-tag",
        "funkyremi.vscode-google-translate",
        "GitHub.vscode-github-actions",
        "GitHub.vscode-pull-request-github",
        "glenn2223.live-sass",
        "helixquar.randomeverything",
        "humao.rest-client",
        "jack89ita.open-file-from-path",
        "jock.svg",
        "kisstkondoros.vscode-gutter-preview",
        "lacroixdavid1.vscode-format-context-menu",
        "Lokalise.i18n-ally",
        "madprops.when-did-i-start-working",
        "ms-azuretools.vscode-containers",
        "ms-playwright.playwright",
        "ms-vscode.live-server",
        "naumovs.color-highlight",
        "neptunedesign.vs-html-to-css",
        "oxc.oxc-vscode",
        "PKief.material-icon-theme",
        "pranaygp.vscode-css-peek",
        "Prisma.prisma",
        "razgraf.react-on-the-fly",
        "redhat.vscode-xml",
        "redhat.vscode-yaml",
        "rid9.datetime",
        "ritwickdey.LiveServer",
        "solnurkarim.html-to-css-autocompletion",
        "SomewhatStationery.some-sass",
        "streetsidesoftware.code-spell-checker",
        "stylelint.vscode-stylelint",
        "svelte.svelte-vscode",
        "syler.sass-indented",
        "sysoev.language-stylus",
        "tamasfe.even-better-toml",
        "techer.open-in-browser",
        "unifiedjs.vscode-mdx",
        "usernamehw.errorlens",
        "vincaslt.highlight-matching-tag",
        "vitest.explorer",
        "Vue.volar",
        "wix.vscode-import-cost",
        "yoavbls.pretty-ts-errors",
        "ysemeniuk.emmet-live",
        "yzhang.markdown-all-in-one"
    ]
}
